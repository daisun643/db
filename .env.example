# Copy this file to .env and replace every change-me value before deployment.

# Public hostname served by Nginx (without http:// or https://).
DOMAIN=example.com

# MinIO credentials. Use the same values for the backend S3 client.
MINIO_ROOT_USER=change-me-minio-user
MINIO_ROOT_PASSWORD=change-me-minio-password

# Oracle XE bootstrap and application user credentials.
ORACLE_PASSWORD=change-me-oracle-sys-password
APP_USER=appuser
APP_USER_PASSWORD=change-me-app-user-password

# SMTP credentials used by the production API for verification/reset emails.
EMAIL_SENDER_EMAIL=replace-with-smtp-sender@example.com
EMAIL_SENDER_PASSWORD=change-me-smtp-password

# Development-only defaults. Production builds always use /api.
VITE_API_BASE_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:5173
